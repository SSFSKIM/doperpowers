#!/usr/bin/python3 -P
"""devcloud: a host's status and its jobs.

  devcloud status            one line per boot step: name, state, when, detail
  devcloud reconcile         boot steps 5-11 against the configuration as fetched now
  devcloud pull-config       fetch and reset ~/.claude; reconcile when the commit moved
  devcloud refresh-secrets   materialize secrets.toml again (steps 7, 10, 11)

Every command but status runs as root. Exit 1 when a step failed (status:
when the last boot did not finish, or a step failed)."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
# Root runs only system binaries: the user can write to their own PATH entries.
os.environ["PATH"] = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
from devcloudlib import status, steps  # noqa: E402

JOBS = {"reconcile": steps.reconcile, "pull-config": steps.pull_config, "refresh-secrets": steps.refresh_secrets}


def main(argv):
    if len(argv) != 1 or argv[0] not in ("status", *JOBS):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    if argv[0] == "status":
        data = status.load()
        if not data["steps"]:
            print("devcloud: no boot recorded", file=sys.stderr)
            return 1
        sys.stdout.write(status.render(data))
        return 0 if status.healthy(data) else 1
    if os.geteuid() != 0:
        print(f"devcloud {argv[0]}: run as root", file=sys.stderr)
        return 1
    return JOBS[argv[0]]()


sys.exit(main(sys.argv[1:]))
