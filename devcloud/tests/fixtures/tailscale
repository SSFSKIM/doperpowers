#!/usr/bin/env python3
"""The stand-in `tailscale`: records each call in $FAKE_TS_LOG (one JSON line),
and for `up --auth-key=file:<path>` that file's mode, owner, its directory's
mode, the attributes the key carries after `?`, and the digest of what comes
before it — never the key itself.
`status --json` reports $FAKE_TS_STATE (default NeedsLogin); `up` exits
$FAKE_TS_EXIT (default 0); `logout` exits $FAKE_TS_LOGOUT_EXIT (default 0).
With $FAKE_TS_NODE (a file) the node is stateful: `up` joins a new node,
named after --hostname unless $FAKE_TS_NAME_TAKEN gives it `<name>-1`, and
`logout` leaves it; `status --json` then reports that node as Self."""
import hashlib
import json
import os
import stat
import sys

call = {"argv": [a if not a.startswith("--auth-key=file:") else "--auth-key=file:<path>" for a in sys.argv[1:]]}
for arg in sys.argv[1:]:
    if arg.startswith("--auth-key=file:"):
        path = arg[len("--auth-key=file:"):]
        st = os.stat(path)
        call["key_mode"] = oct(stat.S_IMODE(st.st_mode))
        call["key_owner"] = st.st_uid
        call["key_dir_mode"] = oct(stat.S_IMODE(os.stat(os.path.dirname(path)).st_mode))
        key = open(path).read()
        secret, _, call["key_attributes"] = key.partition("?")
        call["key_sha256"] = hashlib.sha256(secret.encode()).hexdigest()
with open(os.environ.get("FAKE_TS_LOG", "/tmp/fake-tailscale.jsonl"), "a") as f:
    f.write(json.dumps(call) + "\n")

node_file = os.environ.get("FAKE_TS_NODE")
node = {}
if node_file and os.path.exists(node_file):
    with open(node_file) as f:
        node = json.load(f)
command = sys.argv[1:2]
code = 0
if command == ["up"]:
    code = int(os.environ.get("FAKE_TS_EXIT", "0"))
    if node_file and code == 0:
        name = next(a.split("=", 1)[1] for a in sys.argv if a.startswith("--hostname="))
        count = node.get("joins", 0) + 1
        label = f"{name}-1" if os.environ.get("FAKE_TS_NAME_TAKEN") else name
        node = {"state": "Running", "id": f"nNode{count}CNTRL", "dns": f"{label}.example-tailnet.ts.net.",
                "joins": count, "ephemeral": call.get("key_attributes", "").startswith("ephemeral=true")}
elif command == ["logout"]:
    code = int(os.environ.get("FAKE_TS_LOGOUT_EXIT", "0"))
    if node_file and code == 0:
        node = {"state": "NeedsLogin", "joins": node.get("joins", 0)}
elif command == ["status"]:
    if node_file:
        me = {"ID": node["id"], "DNSName": node["dns"]} if node.get("state") == "Running" else {}
        print(json.dumps({"BackendState": node.get("state", "NeedsLogin"), "Self": me}))
    else:
        print(json.dumps({"BackendState": os.environ.get("FAKE_TS_STATE", "NeedsLogin")}))
if node_file:
    with open(node_file, "w") as f:
        json.dump(node, f)
sys.exit(code)
