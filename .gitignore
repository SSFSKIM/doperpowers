.worktrees/
.private-journal/
.claude/
# .doperpowers/ holds runtime workspaces (sdd/, sde/) — ignored; board.json is
# the repo's committed board binding (A2 spec: checked-in so every fresh
# worktree's workers resolve the same substrate), so the dir pattern must not
# swallow it: a `dir/` exclusion makes children un-reincludable.
.doperpowers/*
!.doperpowers/board.json
.DS_Store
node_modules/
inspo
triage/
.playwright-cli/

# Eval harness lives in its own repository, cloned into evals/ for local
# development (see CLAUDE.md / README.md). It is not part of the published
# plugin, so the whole directory is ignored here.
evals/
__pycache__/

# /teach personal learning workspace (not part of the plugin)
/MISSION.md
/RESOURCES.md
/NOTES.md
/lessons/
/reference/
/learning-records/
/assets/
