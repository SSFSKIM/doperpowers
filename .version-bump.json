{
  "plugins": [
    {
      "name": "doperpowers",
      "files": [
        {
          "path": "package.json",
          "field": "version"
        },
        {
          "path": ".claude-plugin/plugin.json",
          "field": "version"
        },
        {
          "path": ".codex-plugin/plugin.json",
          "field": "version"
        },
        {
          "path": ".claude-plugin/marketplace.json",
          "field": "plugins[name=doperpowers].version"
        }
      ],
      "audit": {
        "exclude": [
          "CHANGELOG.md",
          "RELEASE-NOTES.md",
          "docs/doperpowers/execplans",
          "node_modules",
          ".git",
          ".version-bump.json",
          "scripts/bump-version.sh",
          ".claude",
          ".worktrees",
          "devcloud",
          "to-human"
        ]
      }
    },
    {
      "name": "devcloud",
      "files": [
        {
          "path": "devcloud/.claude-plugin/plugin.json",
          "field": "version"
        },
        {
          "path": ".claude-plugin/marketplace.json",
          "field": "plugins[name=devcloud].version"
        }
      ],
      "audit": {
        "root": "devcloud",
        "exclude": []
      }
    },
    {
      "name": "to-human",
      "files": [
        {
          "path": "to-human/.claude-plugin/plugin.json",
          "field": "version"
        },
        {
          "path": ".claude-plugin/marketplace.json",
          "field": "plugins[name=to-human].version"
        }
      ],
      "audit": {
        "root": "to-human",
        "exclude": []
      }
    }
  ]
}
