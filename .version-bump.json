{
  "plugins": [
    {
      "name": "doperpowers",
      "files": [
        {
          "path": "package.json",
          "field": "version"
        },
        {
          "path": ".claude-plugin/plugin.json",
          "field": "version"
        },
        {
          "path": ".codex-plugin/plugin.json",
          "field": "version"
        },
        {
          "path": ".claude-plugin/marketplace.json",
          "field": "plugins[name=doperpowers].version"
        }
      ],
      "unshipped": [
        "CLAUDE.md",
        "*/CLAUDE.md",
        "README.md",
        "*/README.md",
        "tests/*",
        "AGENTS.md",
        "NOTICE",
        ".github/*",
        ".gitignore",
        ".gitattributes",
        ".pre-commit-config.yaml",
        ".smns",
        ".version-bump.json",
        ".claude-plugin/marketplace.json",
        ".agents/*",
        ".doperpowers/*",
        "docs/*",
        "archive/*",
        "application-agents/*",
        "teaching/*",
        "infra/*",
        "devenv/*",
        "codex/*",
        "evals/*",
        "scripts/*"
      ],
      "audit": {
        "exclude": [
          "CHANGELOG.md",
          "RELEASE-NOTES.md",
          "docs/doperpowers/execplans",
          "node_modules",
          ".git",
          ".version-bump.json",
          "scripts/bump-version.sh",
          ".claude",
          ".worktrees",
          "devcloud",
          "to-human",
          "sminos",
          "web"
        ]
      }
    },
    {
      "name": "devcloud",
      "root": "devcloud",
      "files": [
        {
          "path": "devcloud/.claude-plugin/plugin.json",
          "field": "version"
        },
        {
          "path": ".claude-plugin/marketplace.json",
          "field": "plugins[name=devcloud].version"
        }
      ],
      "unshipped": [
        "CLAUDE.md",
        "*/CLAUDE.md",
        "README.md",
        "*/README.md",
        "tests/*",
        "types/*"
      ],
      "audit": {
        "exclude": []
      }
    },
    {
      "name": "to-human",
      "root": "to-human",
      "files": [
        {
          "path": "to-human/.claude-plugin/plugin.json",
          "field": "version"
        },
        {
          "path": ".claude-plugin/marketplace.json",
          "field": "plugins[name=to-human].version"
        }
      ],
      "unshipped": [
        "CLAUDE.md",
        "*/CLAUDE.md",
        "README.md",
        "*/README.md",
        "tests/*"
      ],
      "audit": {
        "exclude": []
      }
    },
    {
      "name": "sminos",
      "root": "sminos",
      "files": [
        {
          "path": "sminos/.claude-plugin/plugin.json",
          "field": "version"
        },
        {
          "path": ".claude-plugin/marketplace.json",
          "field": "plugins[name=sminos].version"
        }
      ],
      "unshipped": [
        "CLAUDE.md",
        "*/CLAUDE.md",
        "README.md",
        "*/README.md",
        "tests/*",
        "types/*"
      ],
      "audit": {
        "exclude": []
      }
    },
    {
      "name": "web",
      "root": "web",
      "files": [
        {
          "path": "web/.claude-plugin/plugin.json",
          "field": "version"
        },
        {
          "path": ".claude-plugin/marketplace.json",
          "field": "plugins[name=web].version"
        }
      ],
      "unshipped": [
        "CLAUDE.md",
        "*/CLAUDE.md",
        "README.md",
        "*/README.md",
        "tests/*",
        "evals/*"
      ],
      "audit": {
        "exclude": [
          "clipper",
          "runs"
        ]
      }
    }
  ]
}
