#!/usr/bin/env bash
# Extract one milestone's full text from a spec's Plan of Work — or one
# task's from an older execution plan — into a file the executor reads in
# one call, so the text never has to be pasted through the controller's
# context. Headings matched: "M<N> — …", "Milestone <N>…", "Task <N>…".
#
# Usage: task-brief SPEC_FILE NUMBER [OUTFILE]
# Default OUTFILE: <repo-root>/.doperpowers/sde/<spec-basename>/task-<N>-brief.md
# (per spec and per worktree; concurrent runs of the SAME spec in the same
# working tree share it).
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief SPEC_FILE NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such file: $plan" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sde-workspace" "$plan")
  out="$dir/task-${n}-brief.md"
fi

# A brief runs from its heading to the next heading at the same level or
# above — the next milestone, or the section after the Plan of Work
# (Concrete Steps, the record) — so the last milestone's brief does not
# take the rest of the spec with it. Deeper headings inside it are kept.
awk -v n="$n" '
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]/ {
    match($0, /^#+/); lvl = RLENGTH
    if ($0 ~ ("^#+[ \t]+(Task|Milestone|M)[ \t]*" n "([^0-9]|$)")) { intask = 1; tl = lvl }
    else if (intask && lvl <= tl) { intask = 0 }
  }
  intask { print }
' "$plan" > "$out"

if [ ! -s "$out" ]; then
  echo "milestone ${n} not found in ${plan} (no heading matching 'M${n}', 'Milestone ${n}', or 'Task ${n}')" >&2
  exit 3
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
