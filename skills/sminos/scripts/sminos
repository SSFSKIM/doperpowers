#!/usr/bin/env bash
# sminos — the project family for Claude Code sessions: members, seats, the
# project log and its mirror, the daemon. The CLI lives in sminos.py next to this file;
# this launcher only resolves its own real path, because the board pipeline reaches
# it through relative seams (`$SMINOS_CLI`) and symlinks.
exec python3 "$(dirname "$(readlink -f "$0")")/sminos.py" "$@"
