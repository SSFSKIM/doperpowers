<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The sminos daemon, one per machine: syncs each project's mirror, delivers
  what is owed to this machine's members, publishes their state. Rendered by
  `sminos daemon install` into ~/Library/LaunchAgents/{{LABEL}}.plist; the
  placeholders are filled from the installing environment. Load it with
  `launchctl bootstrap gui/$(id -u) <that file>`.
  The program is the Python that ran the install, pinned (the PATH below
  may find an older python3 first, which cannot import sminos), running
  the marketplace clone's sminos.py when the installing one ran from the
  versioned plugin cache, so a plugin update does not strand it; the
  daemon exits when its scripts change and KeepAlive restarts it on the
  new code. The gateway route's values (a token among them) sit here in
  plain text, in a file only its owner can read (0600): accepted.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>{{LABEL}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{PYTHON}}</string>
    <string>{{SMINOS_CLI}}</string>
    <string>daemon</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>EnvironmentVariables</key>
  <dict>
{{ENV}}
  </dict>
  <key>StandardOutPath</key><string>{{LOG}}</string>
  <key>StandardErrorPath</key><string>{{LOG}}</string>
</dict>
</plist>
