#!/usr/bin/env bash
# agora — group registry, spawn topology, and communal board for coding agents.
#
#   agora join     <group> <alias> [--parent P] [--desc D] [--session S] [--addr A]
#   agora leave    <group> <alias>
#   agora post     <group> [--from F] [--title T] [text...]   # board post; stdin if no text
#   agora board    <group> [-n N|--id I] [--json]     # read the board (bodies live here)
#   agora list     <group>                            # member table
#   agora view     <group>                            # ASCII spawn tree + board summary
#   agora topology <group>                            # machine-readable JSON; nodes carry addr
#   agora groups
#
# Member-to-member messaging is NOT here. It rides the harness's native
# cross-session SendMessage tool — which wakes an idle session, queues to a
# busy one, and revives a dead one — and a node's `addr` is its SendMessage
# target. agora owns what that tool lacks: named working groups, the
# who-spawned-whom topology, and a durable communal board.
#
# State lives under $AGORA_HOME (default ~/.claude/agora), machine-global —
# members span repos and worktrees. Group names and aliases are
# [A-Za-z0-9._-]{1,64}; the alias 'human' is the reserved operator identity:
# it never joins, but may post to any board.
#
# Exit codes: 0 ok, 2 usage, 4 unknown group/alias.
set -euo pipefail
# Group state is private to the agent fleet: everything this CLI creates is
# 700/600. All agents run as the same OS user, so nothing needs group/other.
umask 077

AGORA_HOME="${AGORA_HOME:-$HOME/.claude/agora}"

usage() { sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; }
die()  { echo "agora: $1" >&2; exit "${2:-2}"; }
_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

_valid() {
  # '.' and '..' are path segments, not names: they would resolve to the group
  # root / $AGORA_HOME itself. Names that merely contain dots (v1.2) are fine.
  case "$1" in
    ''|.|..|*[!A-Za-z0-9._-]*) return 1 ;;
  esac
  [ "${#1}" -le 64 ]
}

_gdir() { printf '%s/groups/%s' "$AGORA_HOME" "$1"; }

# Sets the global gd for the calling subcommand.
_need_group() {
  _valid "$1" || die "bad group name: $1"
  gd="$(_gdir "$1")"
  [ -d "$gd" ] || die "no such group: $1 (a group is created by its first join)" 4
}

# mkdir spinlock: portable to macOS (no flock there). A lock dir that stays
# for >30s is presumed leaked by a killed process and is broken.
_lock() {
  local lk="$1/locks/board.lock" tries=0 now lkage
  until mkdir "$lk" 2>/dev/null; do
    tries=$((tries + 1))
    if [ "$tries" -gt 200 ]; then
      now=$(date +%s)
      lkage=$(stat -f %m "$lk" 2>/dev/null || stat -c %Y "$lk" 2>/dev/null || echo "$now")
      [ $((now - lkage)) -gt 30 ] && rmdir "$lk" 2>/dev/null
      tries=0
    fi
    sleep 0.05
  done
}
_unlock() { rmdir "$1/locks/board.lock" 2>/dev/null || true; }

# ---------------------------------------------------------------- join / leave

# Aliases are unique per group, but an addr is a machine-wide SendMessage name:
# two live groups each holding an `architect` make sends to that name ambiguous.
# agora cannot see sessions outside its own groups, so this warns about the
# collisions it can see rather than rejecting the join.
_warn_addr_clash() { # group addr
  local nf other
  for nf in "$AGORA_HOME"/groups/*/nodes/*.json; do
    [ -e "$nf" ] || break
    other="$(basename "$(dirname "$(dirname "$nf")")")"
    if [ "$other" = "$1" ]; then continue; fi
    # A node file can vanish mid-scan; an unreadable one simply doesn't clash.
    if [ "$(jq -r '.addr // .alias' "$nf" 2>/dev/null || true)" = "$2" ]; then
      echo "agora: warning: addr '$2' is already held by $other/$(basename "$nf" .json)" \
           "— SendMessage names are machine-wide, so concurrently-live groups need distinct member names" >&2
      return 0
    fi
  done
  return 0
}

cmd_join() {
  local g="${1:?usage: agora join <group> <alias> [--parent P] [--desc D] [--session S] [--addr A]}"; shift
  local a="${1:?missing alias}"; shift
  local parent="" desc="" session="" addr="" joined branch
  while [ $# -gt 0 ]; do case "$1" in
    --parent)  parent="${2:-}";  shift 2 ;;
    --desc)    desc="${2:-}";    shift 2 ;;
    --session) session="${2:-}"; shift 2 ;;
    --addr)    addr="${2:-}";    shift 2 ;;
    *) die "join: unknown option $1" ;;
  esac; done
  _valid "$g" || die "bad group name: $g"
  _valid "$a" || die "bad alias: $a"
  [ "$a" = "human" ] && die "the alias 'human' is reserved for the operator"
  [ -z "$parent" ] || _valid "$parent" || die "bad parent alias: $parent"
  # addr is a harness session name, never a filesystem path, so it is not
  # name-validated — interactive sessions have names like "organize sprint".
  # Daemons spawned under their alias leave it defaulted: alias == addr — which
  # is also why every read site falls back to the alias: the state root is
  # persistent, so records predating the addr field carry no addr at all.
  [ -n "$addr" ] || addr="$a"
  _warn_addr_clash "$g" "$addr"
  gd="$(_gdir "$g")"
  mkdir -p "$gd/nodes" "$gd/locks"
  joined="$(_now)"
  if [ -f "$gd/nodes/$a.json" ]; then
    joined="$(jq -r '.joined' "$gd/nodes/$a.json")"
  fi
  branch="$(git -C "$PWD" branch --show-current 2>/dev/null || true)"
  jq -n --arg alias "$a" --arg parent "$parent" --arg addr "$addr" \
        --arg session "$session" \
        --arg cwd "$PWD" --arg branch "$branch" --arg desc "$desc" \
        --arg joined "$joined" --arg updated "$(_now)" \
        '{alias:$alias,parent:$parent,addr:$addr,session:$session,cwd:$cwd,branch:$branch,desc:$desc,joined:$joined,updated:$updated}' \
        > "$gd/nodes/$a.json.tmp"
  mv "$gd/nodes/$a.json.tmp" "$gd/nodes/$a.json"
  echo "joined $g as $a (parent: ${parent:-none}, addr: $addr)"
}

cmd_leave() {
  local g="${1:?usage: agora leave <group> <alias>}" a="${2:?missing alias}"
  _valid "$a" || die "bad alias: $a"
  _need_group "$g"
  rm -f "$gd/nodes/$a.json"
  echo "left $g: $a (board history kept)"
}

# ---------------------------------------------------------------------- board

# The board is the group's communal surface: durable long-form posts, JSONL
# on disk, rendered as markdown inside XML envelopes on read. Delivery is the
# poster's job: after writing, nudge the members who should read it now with
# a one-line native SendMessage naming the post id (the command prints their
# addrs). A member that is never nudged still finds the post — the board is
# the durable record and `view` summarizes it.

cmd_post() {
  local g="${1:?usage: agora post <group> [--from F] [--title T] [text...]}"; shift
  _need_group "$g"
  local from="${AGORA_ALIAS:-human}" title="" text="" branch ts id rec nf others=""
  while [ $# -gt 0 ]; do case "$1" in
    --from)  from="${2:-}";  shift 2 ;;
    --title) title="${2:-}"; shift 2 ;;
    --) shift; text="$*"; break ;;
    *)  if [ -z "$text" ]; then text="$1"; else text="$text $1"; fi; shift ;;
  esac; done
  [ -n "$text" ] || text="$(cat)"
  [ -n "$text" ] || die "post: empty body"
  _valid "$from" || die "bad --from alias: $from"
  if [ "$from" != "human" ] && [ ! -f "$gd/nodes/$from.json" ]; then
    die "poster $from has not joined $g (run: agora join $g $from)" 4
  fi
  # cwd/branch are snapshotted at post time — the join-time registry values
  # describe where a member started, not where this post was written.
  branch="$(git -C "$PWD" branch --show-current 2>/dev/null || true)"
  ts="$(_now)"
  _lock "$gd"
  touch "$gd/board.jsonl"
  id=$(( $(wc -l < "$gd/board.jsonl") + 1 ))
  rec="$(jq -cn --argjson id "$id" --arg ts "$ts" --arg from "$from" \
                --arg title "$title" --arg cwd "$PWD" --arg branch "$branch" \
                --arg text "$text" \
                '{id:$id,ts:$ts,from:$from,title:$title,cwd:$cwd,branch:$branch,text:$text}')"
  printf '%s\n' "$rec" >> "$gd/board.jsonl"
  _unlock "$gd"
  for nf in "$gd"/nodes/*.json; do
    [ -e "$nf" ] || continue
    # A concurrent `leave` can unlink this node between the glob and the read;
    # a member that just left simply isn't suggested.
    m="$(jq -r --arg f "$from" 'select(.alias != $f) | .addr // .alias' "$nf" 2>/dev/null)" || continue
    [ -n "$m" ] && others="$others, $m"
  done
  echo "posted #$id to $g board"
  if [ -n "$others" ]; then
    echo "  nudge readers via SendMessage — addrs: ${others#, }"
    echo "  e.g.: agora board post #$id by $from${title:+ — \"$title\"} · read with: agora board $g --id $id"
  fi
}

cmd_board() {
  local g="${1:?usage: agora board <group> [-n N|--id I] [--json]}"; shift
  _need_group "$g"
  local n=0 id="" json=false sel
  while [ $# -gt 0 ]; do case "$1" in
    -n) n="${2:-0}"; shift 2 ;;
    --id) id="${2:-}"; shift 2 ;;
    --json) json=true; shift ;;
    *) die "board: unknown option $1" ;;
  esac; done
  [ -s "$gd/board.jsonl" ] || { [ "$json" = true ] || echo "(no posts)"; return 0; }
  # --id is what a nudge names: a post number, fetchable individually — a
  # member with several nudges queued reads each one, not just the latest.
  if [ -n "$id" ]; then
    sel="$(jq -c --argjson i "$id" 'select(.id == $i)' "$gd/board.jsonl")"
    [ -n "$sel" ] || die "no such post on the $g board: #$id" 4
  elif [ "$n" -gt 0 ]; then sel="$(tail -n "$n" "$gd/board.jsonl")"
  else sel="$(cat "$gd/board.jsonl")"
  fi
  printf '%s\n' "$sel" |
  if [ "$json" = true ]; then cat; else
    # Only the envelope's own grammar is neutralized: a body carrying
    # '</agora-post>' would otherwise close the frame early and forge an
    # apparent next post with fake provenance. Both forms need escaping — the
    # opening pattern does not match the closing one. Everything else in a body
    # stays raw; readable markdown is the whole point of the board.
    jq -r 'def esc: gsub("<agora-post"; "&lt;agora-post") | gsub("</agora-post"; "&lt;/agora-post");
           "<agora-post id=\"" + (.id|tostring) + "\" from=\"" + .from + "\" ts=\"" + .ts + "\""
           + (if .branch != "" then " branch=\"" + (.branch|@html) + "\"" else "" end)
           + " cwd=\"" + (.cwd|@html) + "\">"
           + (if .title != "" then "\n## " + (.title|esc) else "" end)
           + "\n" + (.text|esc) + "\n</agora-post>\n"'
  fi
}

# ---------------------------------------------------------- list / view / topo

cmd_list() {
  local g="${1:?usage: agora list <group>}" nf
  _need_group "$g"
  printf '%-16s %-16s %-20s %-36s %s\n' ALIAS PARENT ADDR SESSION DESC
  for nf in "$gd"/nodes/*.json; do
    [ -e "$nf" ] || { echo "(no members)"; return 0; }
    printf '%-16s %-16s %-20s %-36s %s\n' \
      "$(jq -r '.alias' "$nf")" \
      "$(jq -r '.parent | if .=="" then "-" else . end' "$nf")" \
      "$(jq -r '(.addr // .alias) | if .=="" then "-" else . end' "$nf")" \
      "$(jq -r '.session | if .=="" then "-" else . end' "$nf")" \
      "$(jq -r '.desc' "$nf")"
  done
}

_children_of() { # group-dir alias -> child aliases, one per line
  local nf
  for nf in "$1"/nodes/*.json; do
    [ -e "$nf" ] || continue
    # `leave` unlinks node files without the lock, so one can vanish between
    # the glob and the read: a departed member is simply not a child.
    jq -r --arg p "$2" 'select(.parent == $p) | .alias' "$nf" 2>/dev/null || continue
  done
}

# Canonical tree rendering: line_prefix draws THIS node's row, child_prefix is
# what every descendant row inherits — so depth accumulates instead of resetting.
_tree() { # group-dir alias line-prefix child-prefix   (recursive)
  local a="$2" lp="$3" cp="$4" nf d kids k glyph cont count i
  nf="$1/nodes/$a.json"
  d="$(jq -r '.desc' "$nf")"; [ -n "$d" ] && d=" — $d"
  printf '%s%s%s\n' "$lp" "$a" "$d"
  kids="$(_children_of "$1" "$a")"
  count=0; for k in $kids; do count=$((count + 1)); done
  i=0
  for k in $kids; do
    i=$((i + 1))
    if [ "$i" -eq "$count" ]; then glyph="└── "; cont="    "; else glyph="├── "; cont="│   "; fi
    _tree "$1" "$k" "$cp$glyph" "$cp$cont"
  done
}

cmd_view() {
  local g="${1:?usage: agora view <group>}" nf p any=false bc
  _need_group "$g"
  echo "agora group: $g"
  for nf in "$gd"/nodes/*.json; do
    [ -e "$nf" ] || break
    any=true
    p="$(jq -r '.parent' "$nf")"
    if [ -z "$p" ]; then
      _tree "$gd" "$(jq -r '.alias' "$nf")" "" ""
    fi
  done
  [ "$any" = false ] && echo "(no members)"
  for nf in "$gd"/nodes/*.json; do
    [ -e "$nf" ] || break
    p="$(jq -r '.parent' "$nf")"
    if [ -n "$p" ] && [ ! -f "$gd/nodes/$p.json" ]; then
      echo "(dangling — parent '$p' unknown)"
      _tree "$gd" "$(jq -r '.alias' "$nf")" "    " "    "
    fi
  done
  if [ -s "$gd/board.jsonl" ]; then
    bc="$(wc -l < "$gd/board.jsonl" | tr -d ' ')"
    echo "board: $bc post(s) — latest: $(tail -n 1 "$gd/board.jsonl" | jq -r '"#" + (.id|tostring) + (if .title != "" then " \"" + .title + "\"" else "" end) + " by " + .from + " @ " + .ts')"
  fi
  return 0
}

cmd_topology() {
  local g="${1:?usage: agora topology <group>}" nf nodes="[]"
  _need_group "$g"
  for nf in "$gd"/nodes/*.json; do
    [ -e "$nf" ] || break
    nodes="$(printf '%s\n%s' "$nodes" "$(cat "$nf")" | jq -cs '.[0] + [.[1] | .addr = (.addr // .alias)]')"
  done
  jq -n --arg g "$g" --argjson nodes "$nodes" \
    '{group:$g, nodes:$nodes,
      edges:[$nodes[] | select(.parent != "") | {from:.parent, to:.alias}]}'
}

cmd_groups() {
  local d="$AGORA_HOME/groups" gp gn mc last found=false
  [ -d "$d" ] || { echo "(no groups)"; return 0; }
  for gp in "$d"/*/; do
    [ -e "$gp" ] || break
    found=true
    gn="$(basename "$gp")"
    mc=$(find "$gp/nodes" -name '*.json' 2>/dev/null | wc -l | tr -d ' ')
    last="-"
    [ -s "$gp/board.jsonl" ] && last="$(tail -n 1 "$gp/board.jsonl" | jq -r '.ts')"
    printf '%-24s %3s members   last post: %s\n' "$gn" "$mc" "$last"
  done
  [ "$found" = false ] && echo "(no groups)"
  return 0
}

# ------------------------------------------------------------------- dispatch

cmd="${1:-}"; [ -n "$cmd" ] || { usage; exit 2; }
shift
case "$cmd" in
  join)     cmd_join "$@" ;;
  leave)    cmd_leave "$@" ;;
  post)     cmd_post "$@" ;;
  board)    cmd_board "$@" ;;
  list)     cmd_list "$@" ;;
  view)     cmd_view "$@" ;;
  topology) cmd_topology "$@" ;;
  groups)   cmd_groups "$@" ;;
  # Old transport surface, removed when messaging went native. Long-lived
  # sessions still carry transcripts (and old preambles) that reference it.
  send|listen|log)
    die "'$cmd' is gone — messaging rides the harness SendMessage tool now (a node's addr in 'agora topology' is the target); the board (agora post/board) is the durable record" ;;
  -h|--help|help) usage ;;
  *) die "unknown command: $cmd (try: agora help)" ;;
esac
