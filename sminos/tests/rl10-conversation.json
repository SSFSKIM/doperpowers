    {
      "name": "after an endpoint restart: the session lane restated (closed by restated) replaces what was held, a session not restated is withdrawn at once, the replay still spent; an unknown signer held until the head holds it; then a revocation of one of a member's two devices, and its later words spent",
      "steps": [
        { "scene": "device-words", "device": "b2", "seq": 4, "session": "{{session:S2}}", "binding": "words:b2" },
        { "down": { "t": "events", "project": "{{project:P}}", "events": [{ "event": "{{words:b2}}", "signer": { "kind": "device", "member": "{{member:B}}", "device": "{{device:b2}}", "keyId": "{{kid:b2}}" } }] } },
        { "scene": "restart" },
        { "closed": "main" },
        { "open": "main" },
        { "up": { "t": "hello", "protocol": { "major": 1, "minor": 0 }, "capabilities": [], "token": "{{token}}", "sminos": { "version": "1.25.0" }, "policy": { "read_only": false, "ceiling": "settings" } }, "vary": ["sminos.version"] },
        { "down": { "t": "welcome", "protocol": { "major": 1, "minor": 0 }, "capabilities": [], "build": "{{build}}", "identity": { "org": "{{org}}", "hub": "{{hub}}", "name": "{{name}}", "former": [], "ref": "{{ref}}", "enrolled": "{{enrolled}}" }, "policy": { "read_only": false, "ceiling": "settings" }, "stateVersion": 3 }, "vary": ["stateVersion"] },
        { "down": { "t": "revoked", "version": 3, "devices": [], "members": [], "keys": [] }, "vary": ["version"] },
        { "quiet": ["legacy-key?"], "ms": 300, "note": "the key is held: not asked again" },
        { "up": { "t": "session", "message": { "project": "{{project:P}}", "machine": "{{name}}", "session": null, "kind": "machine", "sub": null, "n": null, "body": { "online": true, "policy": { "read_only": false, "ceiling": "settings" }, "checkouts": [{ "path": "{{checkout}}", "branch": "main" }], "desk": { "sminos": "1.25.0", "rpcs": [], "reads": [] } } } }, "vary": ["message.body.desk"] },
        { "up": { "t": "member", "session": "{{session:S1}}", "alias": "main", "project": "{{project:P}}", "lane": "A", "state": "idle", "title": "the main session", "cwd": "{{checkout}}", "launch": "{{launch:L1b}}", "owners": ["@machine"], "ownersProof": [], "origin": { "kind": "terminal" }, "principal": "@machine", "inference": { "kind": "slot", "configDir": "{{configDir}}" }, "controller": { "lane": "A", "since": "2026-10-27T18:01:00Z" } }, "vary": ["controller.since"] },
        { "up": { "t": "member", "session": "{{session:S2}}", "alias": "bob", "project": "{{project:P}}", "lane": "A", "state": "idle", "cwd": "{{checkout}}", "launch": "{{launch:L2}}", "owners": ["{{member:B}}"], "ownersProof": [], "origin": { "kind": "maws", "requester": "{{member:B}}" }, "principal": "{{member:B}}", "inference": { "kind": "slot", "configDir": "{{configDir}}" }, "controller": { "lane": "A", "since": "2026-10-27T18:01:00Z" } }, "vary": ["controller.since"] },
        { "up": { "t": "pending", "project": "{{project:P}}", "raised": [] } },
        { "up": { "t": "session", "message": { "project": "{{project:P}}", "machine": "{{name}}", "session": "{{session:S1}}", "kind": "host", "sub": null, "n": null, "body": { "id": { "writer": "{{name}}/{{session:S1}}", "seq": 1 }, "event": { "ts": "2026-10-27T18:06:00.000Z", "writer": "{{name}}/{{session:S1}}", "seq": 1, "kind": "message", "from": "main", "text": "the build is green" } } } }, "note": "the last 50 host events again after a reconnect, before its restated: the endpoint's durable host mark (hosts.json) outlived its restart, so no second wrote" },
        { "scene": "notified", "session": "{{session:S1}}", "kind": "wrote", "count": 1, "note": "still the one wrote of case 8" },
        { "up": { "t": "restated" }, "note": "sminos's restatement after the welcome is whole: what it left out left" },
        { "scene": "withdrawn", "session": "{{session:S4}}", "within": 2000, "note": "S4 and S3 left while the endpoint was down: their listings are withdrawn at once" },
        { "scene": "withdrawn", "session": "{{app:S3}}", "within": 2000 },
        { "up": { "t": "hello", "project": "{{project:P}}", "name": "maws", "have": { "{{name}}/{{session:S1}}": 3, "{{name}}/{{session:S2}}": 1, "{{name}}/{{session:S3}}": 2, "{{name}}/{{session:S4}}": 2, "{{name}}/human": 9, "hub/{{member:B}}": 4, "old-mini/human": 1 } }, "note": "the machine's vector: S3's and S4's left after their joined, the operator's words to 9" },
        { "down": { "t": "have", "project": "{{project:P}}", "have": {}, "archive": false }, "vary": ["have", "archive"] },
        { "scene": "hub-repost", "writer": "hub/{{member:B}}", "from": 1, "to": 5, "note": "the inbound index survived the restart" },
        { "down": { "t": "spent", "project": "{{project:P}}", "writer": "hub/{{member:B}}", "seq": 5, "reason": "replayed" } },
        { "quiet": ["events"], "ms": 400 },
        { "scene": "hub-rejected", "writer": "hub/{{member:B}}", "seq": 5, "reason": "seen-nonce" },
        { "scene": "device-words", "device": "b3", "seq": 6, "session": "{{session:S2}}", "binding": "words:b3", "note": "a device the endpoint's head doesn't hold yet: its head is behind the hub's" },
        { "quiet": ["events", "spent"], "ms": 400, "note": "held: neither delivered, nor spent, nor rejected" },
        { "scene": "not-rejected", "writer": "hub/{{member:B}}", "seq": 6 },
        { "scene": "add-device", "device": "b3", "note": "the head advances to one that holds b3" },
        { "down": { "t": "revoked", "version": 4, "devices": [], "members": [], "keys": [] }, "vary": ["version"], "note": "the whole set at each new head, before what the head lets through" },
        { "down": { "t": "events", "project": "{{project:P}}", "events": [{ "event": "{{words:b3}}", "signer": { "kind": "device", "member": "{{member:B}}", "device": "{{device:b3}}", "keyId": "{{kid:b3}}" } }] }, "note": "judged again on the new head, and delivered" },
        { "scene": "revoke", "device": "b1" },
        { "down": { "t": "revoked", "version": 5, "devices": ["{{device:b1}}"], "members": [], "keys": ["{{kid:b1}}", "{{kid:b1-step}}"] }, "vary": ["version", "keys"], "note": "the whole set again, on the head that drops the device; sminos marks what b1 signed refused-revoked" },
        { "scene": "device-words", "device": "b1", "seq": 7, "session": "{{session:S2}}", "note": "words signed by the revoked device, arriving after the revocation" },
        { "down": { "t": "spent", "project": "{{project:P}}", "writer": "hub/{{member:B}}", "seq": 7, "reason": "revoked" } },
        { "scene": "hub-rejected", "writer": "hub/{{member:B}}", "seq": 7, "reason": "bad-code" },
        { "up": { "t": "words?", "id": "w-b1-r", "project": "{{project:P}}", "session": "{{session:S2}}", "event": "{{words:b1}}" }, "vary": ["id"] },
        { "down": { "t": "words", "id": "w-b1-r", "verdict": "refuse" } },
        { "up": { "t": "words?", "id": "w-b2-r", "project": "{{project:P}}", "session": "{{session:S2}}", "event": "{{words:b2}}" }, "vary": ["id"], "note": "the member's other device still speaks" },
        { "down": { "t": "words", "id": "w-b2-r", "verdict": "words" } },
        { "scene": "notify", "session": "{{session:S1}}", "kind": "settled", "pending": 0, "note": "req-1 settled while the endpoint was down: the complete set after the welcome leaves S1 out, and the restarted endpoint settles the 1 it told before (notified.json)" }
      ]
    },
    {
      "name": "a question raised after its project opened, and its answer: each single raised and settled moves its session's count at the hub, once per request",
      "steps": [
        { "up": { "t": "session", "message": { "project": "{{project:P}}", "machine": "{{name}}", "session": "{{session:S1}}", "kind": "raised", "sub": null, "n": null, "body": { "session": "{{session:S1}}", "request": "req-3", "tool": "Bash", "input": { "command": "ls" } } } }, "note": "sminos sends a project's complete set only when the project opens; every later question goes up alone" },
        { "scene": "notify", "session": "{{session:S1}}", "kind": "waiting", "pending": 1 },
        { "up": { "t": "session", "message": { "project": "{{project:P}}", "machine": "{{name}}", "session": "{{session:S1}}", "kind": "raised", "sub": null, "n": null, "body": { "session": "{{session:S1}}", "request": "req-4", "tool": "Bash", "input": { "command": "ls" } } } } },
        { "scene": "notify", "session": "{{session:S1}}", "kind": "waiting", "pending": 2 },
        { "up": { "t": "session", "message": { "project": "{{project:P}}", "machine": "{{name}}", "session": "{{session:S1}}", "kind": "settled", "sub": null, "n": null, "body": { "request": "req-3", "winner": "terminal", "outcome": "allow", "by": "terminal" } } }, "note": "DX4's settled draft (sminos_requests.settled_draft): the request, its winner, outcome and by" },
        { "scene": "notify", "session": "{{session:S1}}", "kind": "settled", "pending": 1 },
        { "up": { "t": "session", "message": { "project": "{{project:P}}", "machine": "{{name}}", "session": "{{session:S1}}", "kind": "settled", "sub": null, "n": null, "body": { "request": "req-4", "winner": "terminal", "outcome": "allow", "by": "terminal" } } } },
        { "scene": "notify", "session": "{{session:S1}}", "kind": "settled", "pending": 0, "note": "nothing pending: notified.json holds the session no longer" }
      ]
    }
  ]
}
