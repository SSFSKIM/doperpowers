        { "down": { "t": "spent", "project": "{{project:P}}", "writer": "hub/{{member:B}}", "seq": 2, "reason": "bad-signature" }, "note": "a final verdict: the position is spent, so the writer's later events aren't held behind it" },
        { "quiet": ["events"], "ms": 400 },
        { "scene": "hub-rejected", "writer": "hub/{{member:B}}", "seq": 2, "reason": "bad-code" },
        { "scene": "legacy-words", "seq": 1 },
        { "down": { "t": "events", "project": "{{project:P}}", "events": [{ "event": { "ts": "2026-10-27T18:04:00.000Z", "writer": "old-mini/human", "seq": 1, "kind": "human", "from": "human", "to": "*", "text": "from a machine not yet moved", "mac": { "nonce": "AQ", "value": "AQ" } }, "signer": { "kind": "legacy" } }] }, "vary": ["events.0.event.mac"], "note": "delivered only as a peer message marked unverified" },
        { "scene": "hub-repost", "writer": "hub/{{member:B}}", "from": 1, "to": 3, "note": "the same signed words at the next free seq" },
        { "down": { "t": "spent", "project": "{{project:P}}", "writer": "hub/{{member:B}}", "seq": 3, "reason": "replayed" } },
        { "quiet": ["events"], "ms": 400 },
        { "scene": "hub-rejected", "writer": "hub/{{member:B}}", "seq": 3, "reason": "seen-nonce" },
        { "up": { "t": "words?", "id": "w-b1-a", "project": "{{project:P}}", "session": "{{session:S2}}", "event": "{{words:b1}}" }, "vary": ["id"], "note": "B owns the session: words" },
        { "down": { "t": "words", "id": "w-b1-a", "verdict": "words" } },
        { "up": { "t": "words?", "id": "w-b1-b", "project": "{{project:P}}", "session": "{{session:S1}}", "event": "{{words:b1}}" }, "vary": ["id"], "note": "B holds only list on an @machine session: peer" },
        { "down": { "t": "words", "id": "w-b1-b", "verdict": "peer" } },
        { "up": { "t": "words?", "id": "w-none", "project": "{{project:P}}", "session": "66666666-6666-4666-8666-666666666666", "event": "{{words:b1}}" }, "vary": ["id"], "note": "a session with no member here" },
        { "down": { "t": "words", "id": "w-none", "verdict": "peer" } }
      ]
    },
    {
      "name": "a to-human host message raises one notify wrote, however often it comes again (its resend after the reconnect is case 11's); a raised draft is taken without a mac",
      "steps": [
        { "up": { "t": "session", "message": { "project": "{{project:P}}", "machine": "{{name}}", "session": "{{session:S1}}", "kind": "host", "sub": null, "n": null, "body": { "id": { "writer": "{{name}}/{{session:S1}}", "seq": 1 }, "event": { "ts": "2026-10-27T18:06:00.000Z", "writer": "{{name}}/{{session:S1}}", "seq": 1, "kind": "message", "from": "main", "text": "the build is green" } } } } },
        { "scene": "notified", "session": "{{session:S1}}", "kind": "wrote", "count": 1 },
        { "up": { "t": "session", "message": { "project": "{{project:P}}", "machine": "{{name}}", "session": "{{session:S1}}", "kind": "raised", "sub": null, "n": null, "body": { "session": "{{session:S1}}", "request": "req-1", "tool": "Bash", "input": { "command": "ls" } } } }, "note": "DX4's draft (sminos_requests.raised_draft): no kind, no at, and no mac on RL10" },
        { "scene": "heard", "kind": "raised" },
        { "scene": "notify", "session": "{{session:S1}}", "kind": "waiting", "pending": 1, "note": "a single raised moves its session's count: the hub hears waiting 1, kept in notified.json" }
      ]
    },
    {
      "name": "lane A actions go down as DX2's rpc, the RPC nested under rpc with its nonce, machine, args.session, a decision's args.digest, its context and fingerprint; a spawn's project is the one whose presence lists its checkout",
      "steps": [
        { "scene": "act", "action": "sminos.steer", "session": "{{session:S1}}", "launch": "{{launch:L1}}", "args": { "session": "{{session:S1}}", "text": "keep going" }, "as": "steer" },
        {
          "down": { "t": "rpc", "rpc": { "rpc": "steer", "project": "{{project:P}}", "machine": "{{name}}", "member": "{{member:A}}", "device": "{{device:a1}}", "created": "{{created:steer}}", "nonce": "{{nonce:steer}}", "opId": "{{opId:steer}}", "opCreated": "{{created:steer}}", "args": { "session": "{{session:S1}}", "text": "keep going" }, "context": { "lane": "A", "session": "{{session:S1}}", "launch": "{{launch:L1}}" }, "fingerprint": "{{fingerprint:steer}}" } }
        },
        { "up": { "t": "rpc-result", "project": "{{project:P}}", "opId": "{{opId:steer}}", "nonce": "{{nonce:steer}}", "outcome": { "state": "done", "result": {} } }, "vary": ["outcome"] },
        { "down": { "t": "rpc-ack", "opId": "{{opId:steer}}", "nonce": "{{nonce:steer}}" } },
        { "scene": "act", "action": "sminos.decide", "session": "{{session:S1}}", "launch": "{{launch:L1}}", "args": { "session": "{{session:S1}}", "request": "req-1", "decision": "allow", "digest": { "session": "{{session:S1}}", "request": "req-1", "tool": "Bash", "input_sha256": "4cf29611a66934862f29acfcc817e30b905c1ab73d5e65831413eb6b454d49db" } }, "as": "decide" },
        {
          "down": { "t": "rpc", "rpc": { "rpc": "decide", "project": "{{project:P}}", "machine": "{{name}}", "member": "{{member:A}}", "device": "{{device:a1}}", "created": "{{created:decide}}", "nonce": "{{nonce:decide}}", "opId": "{{opId:decide}}", "opCreated": "{{created:decide}}", "args": { "session": "{{session:S1}}", "request": "req-1", "decision": "allow", "digest": { "session": "{{session:S1}}", "request": "req-1", "tool": "Bash", "input_sha256": "4cf29611a66934862f29acfcc817e30b905c1ab73d5e65831413eb6b454d49db" } }, "context": { "lane": "A", "session": "{{session:S1}}", "launch": "{{launch:L1}}" }, "fingerprint": "{{fingerprint:decide}}" } }
        },
        { "up": { "t": "member", "session": "{{session:S1}}", "alias": "main", "project": "{{project:P}}", "lane": "A", "state": "idle", "title": "the main session", "cwd": "{{checkout}}", "launch": "{{launch:L1b}}", "owners": ["@machine"], "ownersProof": [], "origin": { "kind": "terminal" }, "principal": "@machine", "inference": { "kind": "slot", "configDir": "{{configDir}}" }, "controller": { "lane": "A", "since": "2026-10-27T18:01:00Z" } }, "vary": ["controller.since"], "note": "the session relaunched after the decision was admitted" },
        { "up": { "t": "rpc-result", "project": "{{project:P}}", "opId": "{{opId:decide}}", "nonce": "{{nonce:decide}}", "outcome": { "state": "failed", "error": { "code": "launch", "message": "sealed for another launch of the session" } } }, "vary": ["outcome.error.message"], "note": "the bridge's child refuses a launch other than its own (O12 M7); sminos reports it" },
        { "down": { "t": "rpc-ack", "opId": "{{opId:decide}}", "nonce": "{{nonce:decide}}" } },
        { "scene": "act", "action": "sminos.spawn", "args": { "checkout": "{{checkout}}", "brief": "fix the flake" }, "as": "spawn" },
        { "down": { "t": "rpc", "rpc": { "rpc": "spawn", "project": "{{project:P}}", "machine": "{{name}}", "member": "{{member:A}}", "device": "{{device:a1}}", "created": "{{created:spawn}}", "nonce": "{{nonce:spawn}}", "opId": "{{opId:spawn}}", "opCreated": "{{created:spawn}}", "args": { "checkout": "{{checkout}}", "brief": "fix the flake" }, "fingerprint": "{{fingerprint:spawn}}", "proof": "{{proof:spawn}}" } }, "note": "no context; its signed action rides as proof, kept as the new session's ownersProof" },
        { "scene": "act", "action": "sminos.send", "session": "{{session:S1}}", "launch": "{{launch:L1b}}", "args": { "session": "{{session:S1}}", "text": "and count them" }, "as": "send" },
        {
          "down": { "t": "rpc", "rpc": { "rpc": "send", "project": "{{project:P}}", "machine": "{{name}}", "member": "{{member:A}}", "device": "{{device:a1}}", "created": "{{created:send}}", "nonce": "{{nonce:send}}", "opId": "{{opId:send}}", "opCreated": "{{created:send}}", "args": { "session": "{{session:S1}}", "text": "and count them" }, "context": { "lane": "A", "session": "{{session:S1}}", "launch": "{{launch:L1b}}" }, "fingerprint": "{{fingerprint:send}}" } },
          "note": "a person's message to the session (MAWS's O9 M1 and its Interfaces §E): sminos runs it through the bridge's deliver op in either turn state, under a writer that is no log writer, fenced to the launch"
        },
        { "up": { "t": "rpc-result", "project": "{{project:P}}", "opId": "{{opId:send}}", "nonce": "{{nonce:send}}", "outcome": { "state": "done", "result": { "entered": true, "uuid": "9a3e5c1d-2b4f-4a6e-8c0d-1e2f3a4b5c6d" } } }, "vary": ["outcome"], "note": "the bridge's delivered outcome for its key, waited up to 10 s: {entered: true, uuid}; failed refused-delivery with the bridge's reason; or {submitted: true} past the bound" },
        { "down": { "t": "rpc-ack", "opId": "{{opId:send}}", "nonce": "{{nonce:send}}" } },
        { "scene": "act", "action": "sminos.send", "session": "{{session:S1}}", "launch": "{{launch:L1b}}", "args": { "session": "{{session:S1}}", "text": "and count them" }, "member": "{{member:B}}", "device": "{{device:b1}}", "shares": [{ "member": "{{member:B}}", "grade": "converse" }], "note": "decided by the endpoint as B, who may converse here, and never sent: plain text takes converse. The share is the endpoint's side alone (sminos sends none until O8)" },
        { "scene": "act", "action": "sminos.send", "session": "{{session:S1}}", "launch": "{{launch:L1b}}", "args": { "session": "{{session:S1}}", "text": "/clear" }, "member": "{{member:B}}", "device": "{{device:b1}}", "shares": [{ "member": "{{member:B}}", "grade": "converse" }], "refused": "grade", "note": "a text starting with / takes its slash command's grade (manage for /clear), above B's: refused at the endpoint, so nothing goes down. sminos refuses a / text on its own as well (bad-shape)" },
        { "scene": "act", "action": "sminos.steer", "session": "{{session:S4}}", "launch": "no-bridge", "args": { "session": "{{session:S4}}", "text": "hello?" }, "refused": "unavailable", "note": "no launch: no bridge to fence it" },
        { "scene": "act", "action": "sminos.steer", "session": "{{session:S1}}", "launch": "{{launch:L1b}}", "args": { "session": "{{session:S2}}", "text": "the other one" }, "refused": "malformed", "note": "its own session is not args.session" },
        { "quiet": ["rpc"], "ms": 400 }
      ]
    },
    {
      "name": "query and tombstone go down to sminos's ledger and back with the binding; a DX2-era entry answers none",
      "steps": [
        { "scene": "query", "opId": "{{opId:steer}}", "opCreated": "{{created:steer}}" },
        { "down": { "t": "query", "opId": "{{opId:steer}}", "opCreated": "{{created:steer}}" } },
        { "up": { "t": "queried", "opId": "{{opId:steer}}", "state": "done", "outcome": { "state": "done", "result": {} }, "member": "{{member:A}}", "device": "{{device:a1}}", "fingerprint": "{{fingerprint:steer}}", "target": { "kind": "session", "session": "{{session:S1}}" } }, "vary": ["outcome"] },
        { "scene": "answered", "state": "done", "member": "{{member:A}}" },
        { "scene": "query", "opId": "ZHgyLWVyYS1vcC0wMDAwMDAwMQ" },
        { "down": { "t": "query", "opId": "ZHgyLWVyYS1vcC0wMDAwMDAwMQ" } },
        { "up": { "t": "queried", "opId": "ZHgyLWVyYS1vcC0wMDAwMDAwMQ", "state": "done", "outcome": { "state": "done", "result": {} } }, "vary": ["outcome"], "note": "an entry from before RL10 holds no binding" },
        { "scene": "answered", "state": "done", "member": null },
        { "scene": "tombstone", "opId": "bm90LXJlY2VpdmVkLW9wLTAwMDE", "opCreated": "{{created:steer}}" },
        { "down": { "t": "tombstone", "opId": "bm90LXJlY2VpdmVkLW9wLTAwMDE", "opCreated": "{{created:steer}}" } },
        { "up": { "t": "tombstoned", "opId": "bm90LXJlY2VpdmVkLW9wLTAwMDE", "ok": true } },
        { "scene": "answered", "state": "unavailable", "ok": true },
        { "scene": "query", "opId": "short", "note": "an opId sminos's shape guard refuses: never sent" },
        { "quiet": ["query"], "ms": 300 },
        { "scene": "answered", "state": "unavailable" }
      ]
