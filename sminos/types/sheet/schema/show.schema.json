        "minLength": 1,
        "type": "string"
       },
       "index": {
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "callId",
       "index"
      ],
      "type": "object"
     },
     "multiSelect": {
      "type": "boolean"
     },
     "options": {
