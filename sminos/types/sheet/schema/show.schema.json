  },
  "v": {
   "const": 1,
   "type": "integer"
  }
 },
 "required": [
  "v",
  "session",
  "seq",
  "sent",
  "pending"
 ],
 "title": "What `sminos sheet show --json` prints (plan I4). With --keys, `open`, `hidden` and `closed` are left out and each pending outcome's `text` is its first 500 characters, with `textCut` when it was longer.",
 "type": "object"
}
