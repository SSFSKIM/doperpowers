        "minimum": 1,
        "type": "integer"
       },
       "type": "array"
      },
      "receipt": {
       "type": "string"
      },
      "revision": {
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "how",
      "at",
      "revision",
      "asker",
      "receipt",
      "places"
     ],
     "type": "object"
    },
    {
     "additionalProperties": false,
     "properties": {
      "asker": {
       "$ref": "#/$defs/asker"
      },
      "at": {
       "$ref": "#/$defs/time"
      },
      "deliveredAt": {
       "$ref": "#/$defs/time"
      },
      "header": {
       "type": "string"
      },
      "how": {
       "enum": [
        "dismissed",
        "withdrawn"
       ],
       "type": "string"
      },
      "revision": {
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "how",
      "at",
      "revision",
      "asker"
     ],
     "type": "object"
    }
   ]
  },
  "id": {
   "pattern": "^q[1-9][0-9]*$",
   "type": "string"
  },
  "key": {
   "pattern": "^[A-Za-z0-9._:-]{8,128}$",
   "type": "string"
  },
  "option": {
   "additionalProperties": false,
   "properties": {
    "description": {
