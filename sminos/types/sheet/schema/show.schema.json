     },
     "callId": {
      "minLength": 1,
      "type": "string"
     },
     "context": {
      "type": "string"
     },
     "handle": {
      "pattern": "^q[1-9][0-9]*(@[1-9][0-9]*)?$",
      "type": "string"
     },
     "header": {
      "type": "string"
     },
     "id": {
      "$ref": "#/$defs/id"
     },
     "importedFrom": {
