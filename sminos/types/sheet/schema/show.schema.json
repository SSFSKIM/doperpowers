       },
       "type": "array"
      },
      "places": {
       "items": {
        "minimum": 1,
        "type": "integer"
       },
       "type": "array"
      },
      "question": {
       "$ref": "#/$defs/snapshot"
      },
      "recipient": {
       "$ref": "#/$defs/recipient"
      },
      "revision": {
       "minimum": 1,
       "type": "integer"
      },
