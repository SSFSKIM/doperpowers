      "asker": {
       "$ref": "#/$defs/asker"
      },
      "at": {
       "$ref": "#/$defs/time"
      },
      "deliveredAt": {
       "$ref": "#/$defs/time"
      },
      "header": {
       "type": "string"
      },
      "how": {
       "const": "answered",
       "type": "string"
      },
      "places": {
