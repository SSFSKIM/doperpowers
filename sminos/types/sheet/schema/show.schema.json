     "type": "object"
    },
    {
     "additionalProperties": false,
     "properties": {
      "acceptedAt": {
       "$ref": "#/$defs/time"
      },
      "acrossStop": {
       "type": "boolean"
      },
      "at": {
       "$ref": "#/$defs/time"
      },
      "batch": {
       "$ref": "#/$defs/key"
      },
      "by": {
       "enum": [
        "page",
        "maws",
        "desk",
        "cli"
       ],
       "type": "string"
      },
      "id": {
       "$ref": "#/$defs/id"
      },
      "key": {
       "$ref": "#/$defs/key"
      },
      "kind": {
       "const": "dismiss",
       "type": "string"
      },
      "question": {
       "$ref": "#/$defs/snapshot"
      },
      "recipient": {
       "$ref": "#/$defs/recipient"
      },
      "revision": {
       "minimum": 1,
       "type": "integer"
      },
      "taken": {
       "type": "boolean"
      }
     },
     "required": [
      "key",
      "kind",
      "id",
      "revision",
      "by",
      "at",
      "acceptedAt",
      "recipient",
      "taken",
      "acrossStop",
      "question"
