#!/usr/bin/env python3
"""A stand-in `gh` for the task plugin's suite: `gh api` only, over a JSON
state file, every call logged.

State ($TASK_GH_STATE):
  login         the account the client is authenticated as
  clock         seconds since 2026-11-01T00:00:00Z, advanced by each write
  next_id       the next comment id
  page_size     issues per page of the board query (default 50)
  cross_repo_edges  false to refuse a blocked-by edge between repositories
  fail          [{match, times, status, message, stdin, after}]: a call whose
                argv (joined) or GraphQL operation name contains `match`, and
                whose input contains `stdin` when that is given, fails; with
                `after` it is carried out first and then fails, as a write
                GitHub accepted whose answer was never heard
  hooks         [{match, stdin, times, when: before|after, do: [action]}]: a
                matching call runs its actions before it is served, or after
                (the call's own write done). An action: {comment: {repo,
                number, body, author, createdAt}} (`{last}` in the body is the
                issue's latest comment id), {label: {repo, number, add|remove}},
                {reopen|close: {repo, number, at}}, {delete_comment: {repo,
                id}}, {hide: {repo, number, editor}} (the latest comment, last
                edited by another account), {define: {repo, name}} (a label
                another writer creates), {vanish: {repo}} (the repository gone from
                the credential's sight), {sleep: seconds}, {kill: true} (the
                calling process, killed as the call returns: a writer that
                dies after a write), {run: {argv, env, exit}} (another command
                run to its end meanwhile, with `env` over the call's
                environment; an exit other than `exit`, default 0, fails the
                call)
  repos         {"owner/name": {default_branch, files: {path: text | {base64}},
                 labels: {name: {color, description}}, next,
                 issues: {"<n>": issue}}}
An issue: number, title, body, state (OPEN|CLOSED), stateReason, author,
editor (null), createdAt, labels [names], blocked_by [[repo, n]], parent
[repo, n] | null, comments [{id, author, editor, createdAt, body}],
prs [{number, state, updatedAt, url}], branches [{name, committedDate}],
reopened [createdAt]: when it was reopened, oldest first; pull: true for a
pull request, which shares the issues' numbers and their comments endpoint
and is no issue to GraphQL. search_incomplete: true for a search that timed out.

Each call is appended to $TASK_GH_LOG as {"argv": [...], "stdin": ...}.
"""
import base64
import json
import os
import re
import signal
import subprocess
import sys
import time
import urllib.parse

STATE = os.environ["TASK_GH_STATE"]
LOG = os.environ.get("TASK_GH_LOG")
EPOCH_DAY = "2026-11-01"


def load():
    with open(STATE) as f:
        return json.load(f)


def save(s):
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(s, f, indent=1)
    os.replace(tmp, STATE)


def stamp(s):
    s["clock"] = int(s.get("clock", 0)) + 1
    t = s["clock"]
    return "%sT%02d:%02d:%02dZ" % (EPOCH_DAY, (t // 3600) % 24, (t // 60) % 60, t % 60)


class HTTPError(Exception):
    def __init__(self, status, message, errors=None):
        super().__init__(message)
        self.status = status
        self.message = message
        self.errors = errors


def fail(status, message, errors=None):
    raise HTTPError(status, message, errors)


def repo_of(s, name):
    for key, r in s["repos"].items():
        if key.lower() == name.lower():
            return key, r
    fail(404, "Not Found")


def issue_of(r, n):
    it = r["issues"].get(str(n))
    if it is None:
        fail(404, "Not Found")
    return it


def node_id(repo, n):
    return "I_%s#%d" % (repo, int(n))


def parse_node(s, nid):
    m = re.fullmatch(r"I_(.+)#(\d+)", nid or "")
    if not m:
        fail(422, "Could not resolve to a node with the global id of '%s'" % nid)
    key, r = repo_of(s, m.group(1))
    return key, r, issue_of(r, m.group(2))


def actor(login):
    return {"login": login} if login else None


def state_reason(it):
    """As stored: a closed issue seeded with no reason keeps none, as GitHub
    gives for closes made before it kept reasons."""
    return it.get("stateReason")


def ref_node(s, repo, n, extra=False):
    _, r = repo_of(s, repo)
    it = issue_of(r, n)
    out = {"number": it["number"], "state": it["state"], "stateReason": state_reason(it),
           "repository": {"nameWithOwner": repo}}
    return out


def children_of(s, repo, n):
    out = []
    for key, r in s["repos"].items():
        for it in r["issues"].values():
            p = it.get("parent")
            if p and p[0].lower() == repo.lower() and int(p[1]) == int(n):
                out.append(ref_node(s, key, it["number"]))
    return sorted(out, key=lambda x: (x["repository"]["nameWithOwner"], x["number"]))


def comment_node(c):
    return {"fullDatabaseId": str(c["id"]), "author": actor(c.get("author")),
            "editor": actor(c.get("editor")), "createdAt": c["createdAt"], "body": c["body"]}


def issue_node(s, repo, it):
    return {
        "id": node_id(repo, it["number"]), "number": it["number"], "title": it["title"],
        "url": "https://github.com/%s/issues/%d" % (repo, it["number"]),
        "state": it["state"], "stateReason": state_reason(it), "createdAt": it["createdAt"],
        "body": it["body"], "author": actor(it.get("author")), "editor": actor(it.get("editor")),
        "labels": {"nodes": [{"name": l} for l in it["labels"]]},
        "blockedBy": {"nodes": [ref_node(s, b[0], b[1]) for b in it.get("blocked_by", [])]},
        "parent": ({"number": int(it["parent"][1]), "repository": {"nameWithOwner": it["parent"][0]}}
                   if it.get("parent") else None),
        "subIssues": {"nodes": children_of(s, repo, it["number"])},
        "closedByPullRequestsReferences": {"nodes": it.get("prs", [])},
        "linkedBranches": {"nodes": [{"ref": {"name": b["name"], "target": {"committedDate": b["committedDate"]}}}
                                     for b in it.get("branches", [])]},
        "timelineItems": {"nodes": [{"createdAt": t} for t in it.get("reopened", [])[-1:]]},
    }


def comments_page(it, cursor):
    start = int(cursor) if cursor else 0
    page = it["comments"][start:start + 100]
    more = start + 100 < len(it["comments"])
    return {"pageInfo": {"hasNextPage": more, "endCursor": str(start + 100) if more else None},
            "nodes": [comment_node(c) for c in page]}


# ── GraphQL, by operation name ─────────────────────────────────────────────
def graphql(s, op, v):
    if "owner" in v and not any(k.lower() == ("%s/%s" % (v["owner"], v["name"])).lower() for k in s["repos"]):
        # As GitHub answers for a repository that is missing or that the credential cannot see.
        return {"data": {"repository": None}, "errors": [{"type": "NOT_FOUND", "path": ["repository"],
                "message": "Could not resolve to a Repository with the name '%s/%s'." % (v["owner"], v["name"])}]}
    if op in ("TaskIssue", "TaskComments", "TaskIssueNode"):
        key, r = repo_of(s, "%s/%s" % (v["owner"], v["name"]))
        it = r["issues"].get(str(v["number"]))
        if it is None or it.get("pull"):  # a pull request shares the numbers, never the issue lookup
            return {"data": {"repository": {"issue": None}},
                    "errors": [{"type": "NOT_FOUND", "message": "Could not resolve to an Issue with the number "
                                "of %s." % v["number"]}]}
        if op == "TaskIssueNode":
            node = {"id": node_id(key, it["number"]), "number": it["number"], "state": it["state"],
                    "stateReason": state_reason(it),
                    "blockedBy": {"nodes": [{"number": int(b[1]), "repository": {"nameWithOwner": b[0]}}
                                            for b in it.get("blocked_by", [])]}}
        elif op == "TaskComments":
            node = {"comments": comments_page(it, v.get("cursor"))}
        else:
            node = issue_node(s, key, it)
            node["comments"] = comments_page(it, None)
        return {"data": {"repository": {"issue": node}}}
    if op == "TaskBoard":
        key, r = repo_of(s, "%s/%s" % (v["owner"], v["name"]))
        open_ = sorted((it for it in r["issues"].values() if it["state"] == "OPEN" and not it.get("pull")),
                       key=lambda i: i["number"])
        size = int(s.get("page_size", 50))
        start = int(v["cursor"]) if v.get("cursor") else 0
        page = open_[start:start + size]
        more = start + size < len(open_)
        return {"data": {"repository": {"issues": {
            "pageInfo": {"hasNextPage": more, "endCursor": str(start + size) if more else None},
            "nodes": [dict(issue_node(s, key, it), comments=comments_page(it, None)) for it in page]}}}}
    if op in ("TaskAddBlockedBy", "TaskRemoveBlockedBy"):
        key, _, it = parse_node(s, v["issue"])
        bkey, _, blocker = parse_node(s, v["blocker"])
        edge = [bkey, blocker["number"]]
        if op == "TaskAddBlockedBy":
            if bkey.lower() != key.lower() and s.get("cross_repo_edges") is False:
                fail(422, "Blocking issue must be in the same repository")
            if edge not in it.setdefault("blocked_by", []):
                it["blocked_by"].append(edge)
        else:
            it["blocked_by"] = [b for b in it.get("blocked_by", []) if b != edge]
        stamp(s)
        save(s)
        return {"data": {"x": {"issue": {"number": it["number"]}}}}
    if op in ("TaskAddSubIssue", "TaskRemoveSubIssue"):
        pkey, _, parent = parse_node(s, v["parent"])
        ckey, _, child = parse_node(s, v["child"])
        if op == "TaskAddSubIssue":
            if child.get("parent") and not v.get("replace"):
                fail(422, "Issue may not contain duplicate sub-issues")
            child["parent"] = [pkey, parent["number"]]
        else:
            child["parent"] = None
        stamp(s)
        save(s)
        return {"data": {"x": {"issue": {"number": parent["number"]}}}}
    fail(400, "stand-in: unknown GraphQL operation %r" % op)


# ── REST ───────────────────────────────────────────────────────────────────
def search(s, q, page=1, per_page=30):
    repos, words, state = [], [], None
    for tok in q.split():
        if tok.startswith("repo:"):
            repos.append(tok[5:])
        elif tok in ("is:issue",):
            continue
        elif tok in ("is:open", "is:closed"):
            state = tok[3:].upper()
        else:
            words.append(tok.lower())
    items = []
    for key, r in s["repos"].items():
        if repos and key.lower() not in [x.lower() for x in repos]:
            continue
        for it in sorted(r["issues"].values(), key=lambda i: i["number"]):
            if state and it["state"] != state:
                continue
            text = (it["title"] + " " + (it["body"] or "")).lower()
            if all(w in text for w in words):
                items.append({"number": it["number"], "title": it["title"], "state": it["state"].lower(),
                              "html_url": "https://github.com/%s/issues/%d" % (key, it["number"]),
                              "repository_url": "https://api.github.com/repos/%s" % key, "body": it["body"]})
    if page * per_page > 1000 and (page - 1) * per_page >= 1000:
        fail(422, "Cannot access beyond the first 1000 results, or the page size is too large.")
    # As GitHub: every match counted, only the first 1000 served, a page at a time.
    served = items[:1000][(page - 1) * per_page:page * per_page]
    return {"total_count": len(items), "incomplete_results": bool(s.get("search_incomplete")), "items": served}


def rest(s, method, path, params, data):
    path = path.lstrip("/")
    if path.split("?")[0] == "user":
        return {"login": s["login"]}
    if path.startswith("search/issues"):
        return search(s, params.get("q", ""), int(params.get("page", 1)), int(params.get("per_page", 30)))
    m = re.fullmatch(r"repos/([^/]+/[^/]+)/(.*)", path)
    if not m:
        fail(404, "Not Found")
    key, r = repo_of(s, m.group(1))
    rest_ = m.group(2)
    if rest_.startswith("contents/"):
        text = r.get("files", {}).get(urllib.parse.unquote(rest_[len("contents/"):]))
        if text is None:
            fail(404, "Not Found")
        raw = text["base64"] if isinstance(text, dict) else base64.b64encode(text.encode()).decode()
        return {"encoding": "base64", "content": raw}
    if rest_ == "labels" and method == "GET":
        return [{"name": n, "color": l.get("color", ""), "description": l.get("description", "")}
                for n, l in r.get("labels", {}).items()]
    if rest_ == "labels" and method == "POST":
        if data["name"] in r.get("labels", {}):
            fail(422, "Validation Failed", [{"resource": "Label", "code": "already_exists", "field": "name"}])
        r.setdefault("labels", {})[data["name"]] = {"color": data.get("color", ""),
                                                     "description": data.get("description", "")}
        save(s)
        return {"name": data["name"]}
    if rest_ == "issues" and method == "POST":
        n = int(r.get("next", 1))
        while str(n) in r["issues"]:
            n += 1
        r["next"] = n + 1
        for l in data.get("labels", []):
            r.setdefault("labels", {}).setdefault(l, {"color": "ededed", "description": ""})
        r["issues"][str(n)] = {"number": n, "title": data["title"], "body": data.get("body", ""),
                               "state": "OPEN", "stateReason": None, "author": s["login"], "editor": None,
                               "createdAt": stamp(s), "labels": list(data.get("labels", [])), "blocked_by": [],
                               "parent": None, "comments": []}
        save(s)
        return {"number": n, "node_id": node_id(key, n),
                "html_url": "https://github.com/%s/issues/%d" % (key, n)}
    m = re.fullmatch(r"issues/(\d+)(/.*)?", rest_)
    if not m:
        fail(404, "Not Found")
    it = issue_of(r, m.group(1))
    sub = m.group(2) or ""
    if sub == "" and method == "PATCH":
        if "title" in data:
            it["title"] = data["title"]
        if "body" in data:
            it["body"] = data["body"]
            it["editor"] = s["login"]
        if data.get("state") == "closed":
            it["state"] = "CLOSED"
            it["stateReason"] = {"completed": "COMPLETED", "not_planned": "NOT_PLANNED"}[
                data.get("state_reason", "completed")]
        if data.get("state") == "open" and it["state"] != "OPEN":
            it["state"], it["stateReason"] = "OPEN", "REOPENED"
            it.setdefault("reopened", []).append(stamp(s))
            save(s)
            return {"number": it["number"]}
        stamp(s)
        save(s)
        return {"number": it["number"]}
    if sub == "/labels" and method == "POST":
        for l in data["labels"]:
            r.setdefault("labels", {}).setdefault(l, {"color": "ededed", "description": ""})
            if l not in it["labels"]:
                it["labels"].append(l)
        stamp(s)
        save(s)
        return [{"name": l} for l in it["labels"]]
    lm = re.fullmatch(r"/labels/(.+)", sub)
    if lm and method == "DELETE":
        name = urllib.parse.unquote(lm.group(1))
        if name not in it["labels"]:
            fail(404, "Label does not exist")
        it["labels"].remove(name)
        stamp(s)
        save(s)
        return [{"name": l} for l in it["labels"]]
    if sub == "/comments" and method == "POST":
        cid = int(s.get("next_id", 5000))
        s["next_id"] = cid + 1
        it["comments"].append({"id": cid, "author": s["login"], "editor": None, "createdAt": stamp(s),
                               "body": data["body"]})
        save(s)
        return {"id": cid, "html_url": "https://github.com/%s/issues/%d#issuecomment-%d" % (key, it["number"], cid)}
    fail(404, "Not Found")


def delete_comment(s, path):
    m = re.fullmatch(r"repos/([^/]+/[^/]+)/issues/comments/(\d+)", path.lstrip("/"))
    if not m:
        return False
    _, r = repo_of(s, m.group(1))
    for it in r["issues"].values():
        kept = [c for c in it["comments"] if int(c["id"]) != int(m.group(2))]
        if len(kept) != len(it["comments"]):
            it["comments"] = kept
            stamp(s)
            save(s)
            return True
    fail(404, "Not Found")


# ── hooks: what another writer does at a chosen moment ─────────────────────
def act(action):
    if "run" in action:
        run = action["run"]
        done = subprocess.run(run["argv"], env=dict(os.environ, **run.get("env", {})), stdin=subprocess.DEVNULL,
                              capture_output=True, text=True, timeout=60)
        if done.returncode != run.get("exit", 0):  # a hook that did not do its part fails the call, and says why
            sys.stderr.write("stand-in gh: a hook's command exited %d, not %d: %s\n"
                             % (done.returncode, run.get("exit", 0), done.stderr.strip()))
            sys.exit(1)
        return
    s = load()
    if "sleep" in action:
        time.sleep(float(action["sleep"]))
        return
    if "kill" in action:
        os.kill(os.getppid(), signal.SIGKILL)
        sys.exit(1)  # before the call: it is never served
    kind = next(k for k in ("comment", "label", "reopen", "close", "delete_comment", "hide", "define", "vanish")
                if k in action)
    a = action[kind]
    if kind == "vanish":
        key, r = repo_of(s, a["repo"])
        s["repos"]["gone:" + key] = s["repos"].pop(key)
        save(s)
        return
    _, r = repo_of(s, a.get("repo", next(iter(s["repos"]))))
    if kind == "define":
        r.setdefault("labels", {})[a["name"]] = {"color": "ededed", "description": ""}
        save(s)
        return
    if kind == "delete_comment":
        for it in r["issues"].values():
            it["comments"] = [c for c in it["comments"] if int(c["id"]) != int(a["id"])]
        save(s)
        return
    it = issue_of(r, a["number"])
    if kind == "comment":
        last = it["comments"][-1]["id"] if it["comments"] else 0
        cid = int(s.get("next_id", 5000))
        s["next_id"] = cid + 1
        at = stamp(s)
        it["comments"].append({"id": cid, "author": a.get("author", s["login"]), "editor": a.get("editor"),
                               "createdAt": a.get("createdAt", at), "body": a["body"].replace("{last}", str(last))})
    elif kind == "label":
        if a.get("add") and a["add"] not in it["labels"]:
            it["labels"].append(a["add"])
        if a.get("remove") in it["labels"]:
            it["labels"].remove(a["remove"])
        stamp(s)
    elif kind == "hide":
        it["comments"][-1]["editor"] = a.get("editor", "passer-by")
    elif kind == "reopen":
        it["state"], it["stateReason"] = "OPEN", "REOPENED"
        it.setdefault("reopened", []).append(a.get("at") or stamp(s))
    elif kind == "close":
        it["state"], it["stateReason"] = "CLOSED", a.get("reason", "COMPLETED")
        stamp(s)
    save(s)


def hooks(when, joined, stdin):
    s = load()
    due = []
    for h in s.get("hooks", []):
        if (h.get("when", "before") == when and h.get("times", 1) > 0 and h["match"] in joined
                and h.get("stdin", "") in (stdin or "")):
            h["times"] = h.get("times", 1) - 1
            due.append(h)
    if due:
        save(s)
    for h in due:
        for action in h["do"]:
            act(action)


def refuse(rule):
    status = rule.get("status", 500)
    # A rule with no status plays a failure no answer was heard for (a timeout, the transport).
    sys.stderr.write("gh: %s%s\n" % (rule.get("message", "stand-in failure"),
                                      " (HTTP %d)" % status if status is not None else ""))
    return 1


def main(argv):
    stdin = None
    if "--input" in argv:
        stdin = sys.stdin.read()
    if LOG:
        with open(LOG, "a") as f:
            f.write(json.dumps({"argv": argv, "stdin": stdin}) + "\n")
    if not argv or argv[0] != "api":
        sys.stderr.write("stand-in gh: only `gh api` is served, not %r\n" % (argv[:1],))
        return 1
    method, path, fields, paginate, slurp = None, None, {}, False, False
    i = 1
    while i < len(argv):
        a = argv[i]
        if a in ("-X", "--method"):
            method = argv[i + 1]
            i += 2
        elif a in ("-f", "-F", "--raw-field", "--field"):
            k, _, val = argv[i + 1].partition("=")
            if a in ("-F", "--field"):
                if re.fullmatch(r"-?\d+", val):
                    val = int(val)
                elif val in ("true", "false"):
                    val = val == "true"
            fields[k] = val
            i += 2
        elif a in ("--input", "--hostname"):
            i += 2
        elif a == "--paginate":
            paginate = True
            i += 1
        elif a == "--slurp":
            slurp = True
            i += 1
        elif a.startswith("-"):
            sys.stderr.write("stand-in gh: unknown flag %s\n" % a)
            return 1
        else:
            if path is not None:
                sys.stderr.write("stand-in gh: two paths\n")
                return 1
            path = a
            i += 1
    if path is None or "{owner}" in path or "{repo}" in path:
        sys.stderr.write("stand-in gh: a path that asks the client to resolve a repository: %r\n" % path)
        return 1
    op = None
    if path == "graphql":
        q = fields.pop("query", "")
        mm = re.search(r"\b(query|mutation)\s+(\w+)", q)
        op = mm.group(2) if mm else None
    joined = " ".join(argv) + " " + (op or "")
    hooks("before", joined, stdin)
    s = load()
    after = None
    for rule in s.get("fail", []):
        if rule.get("times", 1) > 0 and rule["match"] in joined and rule.get("stdin", "") in (stdin or ""):
            rule["times"] = rule.get("times", 1) - 1
            save(s)
            if rule.get("after"):
                after = rule
                break
            return refuse(rule)
    try:
        if path == "graphql":
            out = graphql(s, op, fields)
        else:
            data = json.loads(stdin) if stdin else {}
            m = method or ("POST" if (stdin or (fields and path != "search/issues")) else "GET")
            out = None if m == "DELETE" and delete_comment(s, path) else rest(s, m, path, fields, data)
            if paginate and slurp:
                out = [out]
    except HTTPError as e:
        print(json.dumps(dict({"message": e.message}, **({"errors": e.errors} if e.errors else {}))))
        sys.stderr.write("gh: %s (HTTP %d)\n" % (e.message, e.status))
        return 1
    hooks("after", joined, stdin)
    if after is not None:
        return refuse(after)
    if out is None:
        return 0
    print(json.dumps(out))
    if isinstance(out, dict) and out.get("errors"):
        sys.stderr.write("gh: %s\n" % out["errors"][0]["message"])
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
