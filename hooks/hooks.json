{
  "description": "kairos: proactive mode — on from launch with KAIROS=1 or mid-session with /kairos, kept across compaction and resume; /kairos off ends it",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/kairos.sh\""
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "doperpowers:kairos|kairos",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/kairos-toggle.sh\""
          }
        ]
      }
    ]
  }
}
