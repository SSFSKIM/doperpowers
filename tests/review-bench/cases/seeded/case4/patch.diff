+tar -czf "$staged" -C "$BACKUP_SOURCE_DIR" .
+
+# Replicate from the staging copy, before the archive is published locally: a
+# replica holding half an archive is worse than no replica at all, and running
+# the transfer here means a failed one aborts the run before prune.sh ever
+# gets a chance to rotate anything out.
+if [ -n "${BACKUP_REMOTE:-}" ]; then
+  : "${BACKUP_REMOTE_DIR:?BACKUP_REMOTE_DIR must be set when BACKUP_REMOTE is}"
+  replicate "$staged"
+fi
+
+# Only publish the archive once tar (and replication) has finished, so a crash
+# mid-run never leaves a truncated archive where prune.sh counts it as good.
+mv "$staged" "$archive"
