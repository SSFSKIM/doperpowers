+# An empty source tree is a routine state on a freshly provisioned host, not a
+# failure -- but archiving it is not harmless: a week of empty archives rotates
+# the last archive that actually had something in it straight out of the
+# retention window. Exit 3, which run-backup.sh reads as "stop before prune".
+#
+# find's own exit status is checked: an unreadable source tree prints nothing
+# either, and reporting "nothing to archive" for a tree we simply could not
+# read would tell run-backup.sh that a failed run had succeeded.
+if ! first_entry="$(find "$BACKUP_SOURCE_DIR" -mindepth 1 -print -quit)"; then
+  die "could not read source tree: $BACKUP_SOURCE_DIR"
+fi
+if [ -z "$first_entry" ]; then
+  log "source tree is empty, nothing to archive: $BACKUP_SOURCE_DIR"
+  exit 3
+fi
+
+# Headroom is checked against the *uncompressed* size on purpose. The ratio
+# tar will get on an arbitrary source tree is not knowable ahead of time, and
+# over-reserving errs in the direction that leaves the host bootable.
+need_kb="$(du -sk "$BACKUP_SOURCE_DIR" | awk '{ print $1 }')"
+check_free_space "$BACKUP_ARCHIVE_DIR" "$need_kb" "$FORCE"
+
+STAGE="$(make_stage)"
 
